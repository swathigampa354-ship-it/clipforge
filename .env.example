# ClipForge Environment Configuration
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql+asyncpg://clipforge:secret@localhost:5432/clipforge
DB_PASSWORD=change-me

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-in-production-use-a-32-character-random-string
JWT_EXPIRY_MINUTES=15

# Storage
STORAGE_TYPE=local
STORAGE_PATH=./data/storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=clipforge
MINIO_SECRET_KEY=minio-secret

# AI Providers (at least one required)
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# App
MAX_FILE_SIZE_MB=16384
CLIPPYME_BIND=0.0.0.0
CLIPPYME_API_TOKEN=
CLIPPYME_X264_CRF=18
CLIPPYME_X264_PRESET=medium
CLIPPYME_JOB_MAX_ATTEMPTS=3
CLIPPYME_MIN_VIRAL_SCORE=
CLIPPYME_MAX_CLIPS=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# Worker
WORKER_CONCURRENCY=2

# S3 (for production)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=clipforge

# Billing (Phase 2)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Social Publishing (Phase 3)
# UPLOAD_POST_API_KEY=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
